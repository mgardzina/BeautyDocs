{
  "name": "beautydocs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:tenant": "node --import tsx --test lib/tenant-host.test.ts",
    "test:beautydocs-api": "node --import tsx --test lib/beautydocs-api.test.ts",
    "test:beautydocs-forms": "node --import tsx --test lib/beautydocs-form-path.test.ts",
    "test:beautydocs-admin": "node --import tsx --test lib/beautydocs-admin.test.ts",
    "test:i18n": "node --import tsx --test lib/i18n/i18n.test.ts",
    "test:beautydocs-catalog": "node --import tsx --test lib/beautydocs-catalog-path.test.ts lib/beautydocs-catalog-offers.test.ts",
    "api:dev": "node scripts/api.mjs uvicorn app.main:app --reload --port 8080",
    "api:test": "node scripts/api.mjs pytest -q",
    "db:migrate": "node scripts/api.mjs alembic upgrade head",
    "db:revision": "node scripts/api.mjs alembic revision --autogenerate",
    "db:status": "node scripts/api.mjs alembic current",
    "db:history": "node scripts/api.mjs alembic history",
    "db:check": "node scripts/api.mjs alembic check",
    "db:sql": "node scripts/api.mjs alembic upgrade head --sql",
    "db:test": "bash apps/api/scripts/run_postgres_integration_tests.sh",
    "db:copy-legacy": "node scripts/api.mjs app.cli.copy_legacy_database",
    "create-admin": "node scripts/api.mjs app.cli.create_legacy_admin"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "framer-motion": "^12.29.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "resend": "^3.0.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-signature-canvas": "^1.0.7",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
