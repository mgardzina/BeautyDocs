# Copy to .env.production.local on the target server; generate fresh secrets.
# Database passwords must be URL-safe, e.g. openssl rand -hex 24.
POSTGRES_PASSWORD=
BEAUTYDOCS_MIGRATOR_PASSWORD=
BEAUTYDOCS_APP_PASSWORD=
# Generate each independently with: openssl rand -hex 32
BEAUTYDOCS_LEGACY_SERVICE_KEY=
AUTH_SECRET=
BEAUTYDOCS_CHECK_IN_SIGNING_KEY=
# Exactly 32 random bytes encoded as URL-safe base64:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BEAUTYDOCS_MFA_ENCRYPTION_KEY=
