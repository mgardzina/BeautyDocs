BEAUTYDOCS_ENVIRONMENT=local
BEAUTYDOCS_DEBUG=false
BEAUTYDOCS_DOCS_ENABLED=true
BEAUTYDOCS_API_V1_PREFIX=/api/v1
# Public address placed in e-mails and QR invitation links.
# BEAUTYDOCS_PUBLIC_WEB_URL=https://app.beautydocs.pl

BEAUTYDOCS_TENANT_ROOT_DOMAIN=beautydocs.pl
BEAUTYDOCS_ALLOW_LOCALHOST_TENANTS=true
BEAUTYDOCS_RESERVED_SUBDOMAINS=www,app,forms,admin,api,assets,static,support,mail,status

BEAUTYDOCS_CORS_ALLOWED_ORIGINS=http://localhost:3000
BEAUTYDOCS_CORS_ALLOW_CREDENTIALS=true
BEAUTYDOCS_AUTH_ALLOWED_ORIGINS=http://localhost:3000
BEAUTYDOCS_SMSAPI_TOKEN=
BEAUTYDOCS_SMS_SENDER_NAME=BeautyDocs
BEAUTYDOCS_AUTH_SESSION_COOKIE_NAME=beautydocs_session
BEAUTYDOCS_AUTH_SESSION_TTL_SECONDS=43200
BEAUTYDOCS_AUTH_LOGIN_MAX_ATTEMPTS=5
BEAUTYDOCS_AUTH_LOCKOUT_SECONDS=900
BEAUTYDOCS_AUTH_MFA_CHALLENGE_TTL_SECONDS=300
BEAUTYDOCS_AUTH_MFA_MAX_ATTEMPTS=5
BEAUTYDOCS_AUTH_MFA_RESEND_COOLDOWN_SECONDS=60
# Required in production: URL-safe base64 encoding of 32 random bytes.
# BEAUTYDOCS_MFA_ENCRYPTION_KEY=

# Public Google Identity Services Web client ID (no client secret is used).
# BEAUTYDOCS_GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com

# SMTP account used for registration confirmation e-mails. In local/test mode
# these may stay empty and the UI will display a development verification code.
# BEAUTYDOCS_EMAIL_SMTP_HOST=smtp.example.com
# BEAUTYDOCS_EMAIL_SMTP_PORT=587
# BEAUTYDOCS_EMAIL_SMTP_USERNAME=
# BEAUTYDOCS_EMAIL_SMTP_PASSWORD=
# BEAUTYDOCS_EMAIL_SMTP_SECURITY=starttls
# BEAUTYDOCS_EMAIL_FROM_ADDRESS=hello@beautydocs.pl
# BEAUTYDOCS_EMAIL_FROM_NAME=BeautyDocs

# Free production access key issued by GUS after registration at api.stat.gov.pl.
# BEAUTYDOCS_REGON_API_KEY=
# BEAUTYDOCS_REGON_API_URL=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
# BEAUTYDOCS_REGON_API_TIMEOUT_SECONDS=10

# Alembic and the async FastAPI session layer use this URL.
BEAUTYDOCS_DATABASE_URL=postgresql+asyncpg://beautydocs_app:change-me@localhost:5434/beautydocs
# Alembic uses separate credentials; the API must never use the table owner.
BEAUTYDOCS_MIGRATION_DATABASE_URL=postgresql+asyncpg://beautydocs_migrator:change-me@localhost:5434/beautydocs
# Match the Next.js server-only value to enable the /admin SQLAlchemy transport.
# Generate with: openssl rand -hex 32
# BEAUTYDOCS_LEGACY_SERVICE_KEY=
BEAUTYDOCS_DATABASE_POOL_SIZE=5
BEAUTYDOCS_DATABASE_MAX_OVERFLOW=5
BEAUTYDOCS_DATABASE_POOL_TIMEOUT_SECONDS=10
BEAUTYDOCS_DATABASE_POOL_RECYCLE_SECONDS=1800
BEAUTYDOCS_DATABASE_CONNECT_TIMEOUT_SECONDS=5
BEAUTYDOCS_DATABASE_STATEMENT_TIMEOUT_MS=15000

# Configure both values together only behind a trusted reverse proxy.
# BEAUTYDOCS_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# BEAUTYDOCS_INTERNAL_TENANT_HEADER_SECRET=replace-with-a-secret
