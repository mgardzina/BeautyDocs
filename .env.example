# Next.js calls the Python API; it does not connect to PostgreSQL directly.
BEAUTYDOCS_API_INTERNAL_URL=http://localhost:8080
# Match apps/api/.env. Generate a random key with: openssl rand -hex 32
BEAUTYDOCS_LEGACY_SERVICE_KEY=
# NextAuth still handles /admin login sessions; it no longer uses Prisma.
# Generate a separate random secret with: openssl rand -hex 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
