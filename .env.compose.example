# Local development stack. Copy to .env.compose.local and replace passwords.
# Use URL-safe passwords (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=replace-local-postgres-password
BEAUTYDOCS_MIGRATOR_PASSWORD=replace-local-migrator-password
BEAUTYDOCS_APP_PASSWORD=replace-local-app-password
BEAUTYDOCS_LEGACY_SERVICE_KEY=replace-with-a-random-key-at-least-32-characters
AUTH_SECRET=replace-with-a-different-random-key-at-least-32-characters
BEAUTYDOCS_DB_PORT=5434
BEAUTYDOCS_API_PORT=8080
BEAUTYDOCS_WEB_PORT=3000

# Google Web client ID; allow the local web origin in Google Cloud Console.
BEAUTYDOCS_GOOGLE_CLIENT_ID=
